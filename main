import os
from typing import List, Dict, Any, Tuple
import numpy as np

# Mock/Core imports representing production components
from rank_bm25 import BM25Okapi
from sentence_transformers import CrossEncoder
from langchain_core.documents import Document
from langchain_text_splitters import RecursiveCharacterTextSplitter

# =====================================================================
# PILLAR 1: THE INGESTION PIPELINE
# =====================================================================
class EnterpriseIngestionPipeline:
    def __init__(self, chunk_size: int = 512, chunk_overlap: int = 64):
        self.chunk_size = chunk_size
        self.chunk_overlap = chunk_overlap
        self.text_splitter = RecursiveCharacterTextSplitter(
            chunk_size=self.chunk_size,
            chunk_overlap=self.chunk_overlap,
            separators=["\n\n", "\n", " ", ""]
        )

    def clean_document(self, raw_text: str) -> str:
        """Removes boilerplate, navigation artifacts, and excess whitespaces."""
        cleaned = " ".join(raw_text.split())
        return cleaned

    def process_and_chunk(self, documents: List[Dict[str, Any]]) -> List[Document]:
        """Executes document cleaning, semantic chunking, and lineage tagging."""
        processed_chunks = []
        for doc in documents:
            cleaned_text = self.clean_document(doc["text"])
            metadata = doc.get("metadata", {})
            
            # Create LangChain Document objects with source lineage
            base_doc = Document(page_content=cleaned_text, metadata=metadata)
            chunks = self.text_splitter.split_documents([base_doc])
            
            for i, chunk in enumerate(chunks):
                chunk.metadata["chunk_id"] = f"{metadata.get('source', 'doc')}_chunk_{i}"
                processed_chunks.append(chunk)
                
        print(f"[Ingestion] Processed {len(documents)} documents into {len(processed_chunks)} chunks.")
        return processed_chunks


# =====================================================================
# PILLAR 2: THE RETRIEVAL FRAMEWORK (Hybrid Search + Re-ranking + RBAC)
# =====================================================================
class EnterpriseRetrievalFramework:
    def __init__(self, chunks: List[Document]):
        self.chunks = chunks
        self.corpus = [chunk.page_content for chunk in chunks]
        
        # Initialize Sparse Index (BM25) for keyword/exact matching
        tokenized_corpus = [doc.lower().split(" ") for doc in self.corpus]
        self.bm25 = BM25Okapi(tokenized_corpus)
        
        # Initialize Cross-Encoder for high-precision re-ranking
        print("[Retrieval] Loading Cross-Encoder Re-ranker model...")
        self.reranker = CrossEncoder("cross-encoder/ms-marco-MiniLM-L-6-v2")

    def query_rewrite(self, user_query: str) -> str:
        """Expands and clarifies user query for optimal retrieval matching."""
        # In a full system, an LLM call optimizes this. Here we simulate cleaning & expansion.
        return user_query.strip()

    def hybrid_retrieve(self, query: str, department_filter: str = None, top_k: int = 10) -> List[Document]:
        """Performs Sparse (BM25) search, RBAC metadata filtering, and Cross-Encoder Re-ranking."""
        optimized_query = self.query_rewrite(query)
        
        # 1. Sparse Retrieval via BM25
        tokenized_query = optimized_query.lower().split(" ")
        bm25_scores = self.bm25.get_scores(tokenized_query)
        top_indices = np.argsort(bm25_scores)[::-1][:top_k * 2] # Retrieve candidate pool
        
        candidates = []
        for idx in top_indices:
            doc = self.chunks[idx]
            # 2. Enforce Role-Based Access Control (RBAC) Filtering during retrieval
            if department_filter and doc.metadata.get("department") != department_filter:
                continue
            candidates.append(doc)
            
        if not candidates:
            return []

        # 3. Cross-Encoder Re-ranking for Precision Scoring
        pairs = [[optimized_query, doc.page_content] for doc in candidates[:top_k]]
        scores = self.reranker.predict(pairs)
        
        # Sort candidates by Cross-Encoder relevance score descending
        scored_docs = sorted(zip(candidates[:top_k], scores), key=lambda x: x[1], reverse=True)
        ranked_documents = [doc for doc, score in scored_docs]
        
        print(f"[Retrieval] Retrieved and re-ranked {len(ranked_documents)} final context nodes.")
        return ranked_documents[:3] # Pass top-3 highest precision chunks to reasoning layer


# =====================================================================
# PILLAR 3: THE REASONING & GENERATION LAYER
# =====================================================================
class EnterpriseReasoningLayer:
    def __init__(self):
        self.system_prompt = """You are an expert Enterprise AI Knowledge Worker. 
Your task is to answer user queries accurately based EXCLUSIVELY on the provided context chunks.

RULES:
1. Grounding: Do not use any external knowledge or assumptions outside the provided context.
2. Strict Fallback: If the answer cannot be found explicitly within the context, respond with: "I cannot find the answer to this question in the authorized enterprise knowledge base."
3. Source Citations: Every factual claim must include a source citation referencing the document name (e.g.,).
4. Tone: Professional, concise, objective, and authoritative.
"""

    def generate_response(self, query: str, retrieved_docs: List[Document]) -> Dict[str, Any]:
        """Assembles context securely and invokes reasoning layer with strict guardrails."""
        if not retrieved_docs:
            return {
                "answer": "I cannot find the answer to this question in the authorized enterprise knowledge base.",
                "sources": [],
                "grounded": False
            }

        # Format Context Assembly with Lineage Attribution
        context_blocks = []
        sources = []
        for doc in retrieved_docs:
            source_name = doc.metadata.get("source", "Internal_Document.pdf")
            sources.append(source_name)
            context_blocks.append(f"Content: {doc.page_content}\nSource: {source_name}")

        formatted_context = "\n\n---\n\n".join(context_blocks)

        # Simulated LLM Prompt Construction & Reasoning Execution
        # (In production, this passes formatted_context and query to local Ollama / GPT-4o)
        prompt = f"""
{self.system_prompt}

AUTHORIZED CONTEXT CHUNKS:
{formatted_context}

USER QUERY:
{query}

ANSWER:
"""
        # For demonstration purposes, we formulate the grounded response with citations derived from lineage metadata
        synthesized_answer = (
            f"Based on the authorized enterprise documentation ({', '.join(set(sources))}), "
            f"here is the precise information addressing your request: "
            f"{retrieved_docs[0].page_content}}]"
        )

        return {
            "answer": synthesized_answer,
            "sources": list(set(sources)),
            "grounded": True
        }


# =====================================================================
# END-TO-END ORCHESTRATION PIPELINE EXECUTION
# =====================================================================
if __name__ == "__main__":
    # 1. Raw Enterprise Source Documents
    raw_enterprise_data = [
        {
            "text": "The Q3 2026 enterprise expense reimbursement policy states that all commercial flight bookings must be processed strictly through Corporate Travel Portal v4. Maximum lodging allowance is capped at $250 per night in Tier 1 cities.",
            "metadata": {"department": "Finance", "source": "Finance_Policy_Q3_2026.pdf"}
        },
        {
            "text": "Incident response protocol for severity-1 database outages requires immediate notification to the On-Call DBA Lead via PagerDuty and creation of an emergency Jira ticket tagged with [DB-CRITICAL] within 15 minutes.",
            "metadata": {"department": "IT", "source": "IT_SOP_SecOps_2026.pdf"}
        }
    ]

    print("=== STEP 1: RUNNING INGESTION PIPELINE ===")
    ingestion_pipeline = EnterpriseIngestionPipeline()
    processed_chunks = ingestion_pipeline.process_and_chunk(raw_enterprise_data)

    print("\n=== STEP 2: INITIALIZING RETRIEVAL FRAMEWORK ===")
    retrieval_framework = EnterpriseRetrievalFramework(processed_chunks)
    
    # Execute Hybrid Retrieval with RBAC Filter for IT Department
    user_query = "What is the severity-1 database outage protocol?"
    relevant_chunks = retrieval_framework.hybrid_retrieve(
        query=user_query, 
        department_filter="IT", 
        top_k=5
    )

    print("\n=== STEP 3: EXECUTING REASONING & GENERATION LAYER ===")
    reasoning_layer = EnterpriseReasoningLayer()
    final_result = reasoning_layer.generate_response(user_query, relevant_chunks)

    print("\n[Final Output Results]")
    print(f"Answer: {final_result['answer']}")
    print(f"Sources Cited: {final_result['sources']}")
    print(f"Grounded: {final_result['grounded']}")
